# Copy to .env.local and fill in what you need. Every value is optional:
# with nothing set, the app runs fully in demo mode with bundled sample data.

# Base URL of the Le Crimson REST backend (e.g. https://api.example.com).
# When unset, the built-in demo API is used.
VITE_API_BASE_URL=

# Google Identity Services OAuth client ID. When set, "Sign in with Google"
# appears next to "Try the demo". Add your dev/prod origins in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# Optional form endpoint (e.g. Formspree) for the contact page. Unset = demo submit.
VITE_CONTACT_ENDPOINT=

# "browser" (default) or "hash". Use "hash" for static hosts without SPA fallback.
VITE_ROUTER_MODE=browser
